# =============================================================================
# embed-dev-lab
# 构建产物、IDE 本地缓存、厂商大文件、MCP cargo 缓存等不入库
# =============================================================================

# --- 构建产物 ---
build/
**/build/
compile_commands.json

# --- clangd 索引缓存（模块内 .cache/clangd，非仅仓库根）---
**/.cache/
.cache/

# --- IDE 本地配置（launch/tasks/extensions 仍提交）---
.vscode/settings.local.json
.cursor/plans/

# --- Python（install-mcp-skills / mcp-merge.py 等）---
__pycache__/
*.py[cod]
*.pyo
.Python

# --- Agent / 维护临时目录 ---
.project-memory-backups/
logs/
graphify-out/
temp_args.json
ERROR.md

# --- Codegraph 本地索引（SQLite / daemon，体积大，勿入库）---
.codegraph/

# --- 异常 TEMP 落盘（如 node-compile-cache 误写到仓库根 undefined/）---
undefined/

# --- 应用层文档（可提交）---
#   doc/projects/                    固件小工程说明（与 projects/<name>/ 对应）
#   projects/README.md               应用层代码入口说明

# --- OS 残留 ---
.DS_Store
Thumbs.db
Desktop.ini

# --- 编译中间文件 / 二进制（模块 build/ 与 vendor-pack 驱动包见下方例外）---
*.d
*.o
*.ko
*.obj
*.elf
*.ilk
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.so
*.so.*
*.dylib
*.out
*.app
*.i*86
*.x86_64
*.hex
*.bin
*.dSYM/
*.su
*.idb
*.pdb
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
*.dwo

# 可执行文件（保留 vendor-pack 内 ST-Link WinUSB 安装器）
*.exe
!vendor-pack/STLink/STLink/USBDriver/
!vendor-pack/STLink/STLink/USBDriver/**
!vendor-pack/STLink/STLink/USBDriver/dpinst_amd64.exe
!vendor-pack/STLink/STLink/USBDriver/dpinst_x86.exe
!vendor-pack/STLink/STLink/USBDriver/amd64/
!vendor-pack/STLink/STLink/USBDriver/amd64/**
!vendor-pack/STLink/STLink/USBDriver/x86/
!vendor-pack/STLink/STLink/USBDriver/x86/**

# 动态库（保留 USBDriver 内 WinUSB 安装依赖）
*.dll
!vendor-pack/STLink/STLink/USBDriver/amd64/*.dll
!vendor-pack/STLink/STLink/USBDriver/x86/*.dll

# --- vendor-pack：厂商驱动 + CMSIS 子模块 + 板级参考 + Cube 固件 ---
#
# 目录说明：
#   vendor-pack/STLink/              ST-Link WinUSB 驱动（脚本依赖 USBDriver/，可提交）
#   vendor-pack/cmsis-core/          CMSIS-Core git submodule（cm3 / v5.6.0_cm3，随仓库提交指针）
#   vendor-pack/cmsis-device-f1/     CMSIS-Device F1 git submodule（v4.3.5，与 Core 成对）
#   vendor-pack/cmsis-*.embed-dev-lab.md  子模块说明（可提交，勿放入 submodule 目录内）
#   vendor-pack/stm32f1xx-hal-driver/     HAL Driver F1 git submodule（v1.1.8，随仓库提交指针）
#   vendor-pack/stm32f1xx-hal-driver.embed-dev-lab.md  HAL 子模块说明（可提交，勿放入 submodule 目录内）
#   vendor-pack/STM32F103C8T6核心板/  核心板 MDK 例程、PCB 等参考（~360MB，仅本地）
#   vendor-pack/STM32CubeF1/         ST 官方 F1 全包（fetch 脚本，仅 README 提交；HAL/例程可选）
#   vendor-pack/*.zip / *.7z         原始压缩包，本地解压后使用
#
# 注意：cmsis-core / cmsis-device-f1 / stm32f1xx-hal-driver 为 submodule，内容由 .gitmodules 管理，此处勿 ignore。
# 参考：scripts/fetch-cmsis.sh、scripts/fetch-stm32cubef1.sh、doc/learn/stm32-cmsis-component-repos.md

# 核心板参考包（体积大，与仓库 demo 无构建依赖）
vendor-pack/STM32F103C8T6核心板/

# STM32CubeF1 固件包（体积大，本地 fetch）
vendor-pack/STM32CubeF1/archives/
vendor-pack/STM32CubeF1/archives/**
vendor-pack/STM32CubeF1/STM32CubeF1-*/
vendor-pack/STM32CubeF1/STM32CubeF1/
!vendor-pack/STM32CubeF1/README.md

# 厂商原始压缩包
vendor-pack/*.zip
vendor-pack/*.7z
vendor-pack/*.rar

# ST-Link 包内非 WinUSB 脚本所需文件
vendor-pack/STLink/STLink/Error.log
vendor-pack/STLink/STLink/*.dll
vendor-pack/STLink/STLink/*.exe
vendor-pack/STLink/STLink/*.bin

# --- ST 官方 PDF（本地 fetch，不全量进库）---
doc/reference/stm32f103/pdf/*.pdf
!doc/reference/stm32f103/pdf/.gitkeep

# --- MCP 构建缓存（embedded-debugger-mcp cargo build）---
.tools/
